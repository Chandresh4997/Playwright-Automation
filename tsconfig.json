{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    // "allowImportingTsExtensions": true,
    "strict": false
  },
  "include": ["features/**/*.ts", "pages/**/*.ts", "fixtures/**/*.ts", "tests/**/*.ts", "utils/**/*.ts"]
}
